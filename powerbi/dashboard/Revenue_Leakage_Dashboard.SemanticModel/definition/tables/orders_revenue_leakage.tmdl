table orders_revenue_leakage
	lineageTag: bc49abed-d95a-4d44-85da-482a5d830949

	measure 'Total Orders' = COUNTROWS(orders_revenue_leakage)
		formatString: 0
		lineageTag: b826f99e-a3fe-4b62-a266-bc0871a577f4

	measure 'Total Order Value' = SUM(orders_revenue_leakage[total_order_value])
		formatString: "₹"#,0.00;#,0.00\ -"₹";"₹"#,0.00
		lineageTag: 160264d3-40b4-46bd-9d26-7eee70c8b029

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}

	measure 'Revenue Loss' = SUM(orders_revenue_leakage[revenue_loss_amount])
		formatString: "₹"#,0.00;#,0.00\ -"₹";"₹"#,0.00
		lineageTag: 285f6eda-853f-4b5f-b118-029bc38b8fe0

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}

	measure 'Net Revenue' = SUM(orders_revenue_leakage[net_revenue])
		formatString: "₹"#,0.00;#,0.00\ -"₹";"₹"#,0.00
		lineageTag: 096d4322-c7bc-4b12-b344-d37fa93aaf19

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}

	measure 'Leakage Rate' =
			DIVIDE(
			    [Revenue Loss],
			    [Total Order Value]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0fa05142-08f9-412f-a6c6-cb7344c1cb45

	measure 'Failed Orders' =
			CALCULATE(
			    [Total Orders],
			    orders_revenue_leakage[is_failed_order] = "Yes"
			)
		formatString: 0
		lineageTag: 2e23dabd-be7d-4752-a99f-801781b6c883

	measure 'Failure Rate' =
			DIVIDE(
			    [Failed Orders],
			    [Total Orders]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c3b46be1-9fc5-48d0-97f4-823e654e29b8

	measure 'Leakage Orders' =
			
			CALCULATE(
			    COUNTROWS(orders_revenue_leakage),
			    orders_revenue_leakage[revenue_leakage_flag] = "Yes"
			)
		lineageTag: d322a9ea-2d20-418a-8f8e-f49feeb7bfb6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Loss per Leakage Order' =
			
			DIVIDE(
			    [Revenue Loss],
			    [Leakage Orders]
			)
		formatString: "₹"#,0.00;#,0.00\ -"₹";"₹"#,0.00
		lineageTag: 6e184982-be97-4285-af44-1b42d3564cd6

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}

	measure 'Product Revenue Loss' =
			
			SUMX(
			    VALUES(order_items_revenue_leakage[order_item_id]),
			    VAR OrderID =
			        CALCULATE(MAX(order_items_revenue_leakage[order_id]))
			    VAR OrderLoss =
			        CALCULATE(
			            MAX(orders_revenue_leakage[revenue_loss_amount]),
			            orders_revenue_leakage[order_id] = OrderID
			        )
			    VAR OrderItems =
			        CALCULATE(
			            COUNTROWS(order_items_revenue_leakage),
			            ALL(order_items_revenue_leakage),
			            order_items_revenue_leakage[order_id] = OrderID
			        )
			    RETURN
			        DIVIDE(OrderLoss, OrderItems)
			)
		lineageTag: dae67ba7-bc6b-463b-b059-3e9ee8a7f1a4

		annotation PBI_FormatHint = {"isGeneralNumber":true}


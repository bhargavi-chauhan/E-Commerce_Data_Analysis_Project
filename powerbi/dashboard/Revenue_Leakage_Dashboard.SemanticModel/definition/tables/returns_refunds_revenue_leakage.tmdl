table returns_refunds_revenue_leakage
	lineageTag: 99698ffd-3880-47c8-aaaa-6ec12c4a4349

	measure 'Total Return Cases' =
			
			COUNTROWS(returns_refunds_revenue_leakage)
		formatString: 0
		lineageTag: 7fe43ad3-ab92-4bd5-9632-85f0786c993b

	measure 'Total Refund Amount' = SUM(returns_refunds_revenue_leakage[refund_amount])
		formatString: "₹"#,0.00;#,0.00\ -"₹";"₹"#,0.00
		lineageTag: bfe384b5-bc99-4e85-a9fa-1592c1594b3b

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}

	measure 'Total Operational Return Cost' =
			
			SUM(returns_refunds_revenue_leakage[reverse_logistics_cost])
			+
			SUM(returns_refunds_revenue_leakage[restocking_cost])
		formatString: "₹"#,0.00;#,0.00\ -"₹";"₹"#,0.00
		lineageTag: 5c7d4659-84dc-4d15-a554-ce7151e19981

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}

	measure 'Pending Refund Amount' =
			
			CALCULATE(
			    [Total Refund Amount],
			    returns_refunds_revenue_leakage[refund_status] = "Pending"
			)
		formatString: "₹"#,0.00;#,0.00\ -"₹";"₹"#,0.00
		lineageTag: 9875923d-5639-4d37-92bf-bd6b378fd73b

		annotation PBI_FormatHint = {"currencyCulture":"hi-IN"}


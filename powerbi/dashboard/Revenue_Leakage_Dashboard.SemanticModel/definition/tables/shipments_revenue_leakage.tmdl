table shipments_revenue_leakage
	lineageTag: 70260b68-7d11-469a-aa4d-fb314f5255a8

	measure 'Total Shipments' = COUNTROWS(shipments_revenue_leakage)
		formatString: 0
		lineageTag: 71905c9f-2ad9-4ed2-8d9f-b0096c5ec4ad

	measure 'Failed Shipments' =
			
			CALCULATE(
			    [Total Shipments],
			    shipments_revenue_leakage[delivery_status] = "Failed"
			)
		formatString: 0
		lineageTag: 492f8a9a-2b1a-479f-85cf-be9fb49840fa

	measure 'Late Shipments' =
			
			CALCULATE(
			    [Total Shipments],
			    shipments_revenue_leakage[is_late_delivery] = "Yes"
			)
		formatString: 0
		lineageTag: a8c80b3b-6158-4f9b-91f8-c9d0ef2978a0

	measure 'Delivery Success Rate' =
			
			DIVIDE(
			    CALCULATE(
			        [Total Shipments],
			        shipments_revenue_leakage[delivery_status] = "Delivered"
			    ),
			    [Total Shipments]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8d206b2e-779c-4ccb-8746-9f6cff5a8231

	measure 'Shipment Failure Rate' =
			
			DIVIDE(
			    [Failed Shipments],
			    [Total Shipments]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e67036e1-a8bc-4692-a35b-cef174e9e147

	measure 'Average Delay Days' =
			
			AVERAGE(shipments_revenue_leakage[delay_days_clean])
		lineageTag: 6ce74c51-88c7-4e0c-b4fb-5ff183bfee26

		annotation PBI_FormatHint = {"isGeneralNumber":true}

